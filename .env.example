# Production-ready template. Copy to .env and adjust for your environment.
# For Render free tier, use the values injected by Render (see render.yaml).

DB_PASSWORD=cbt_local_password
SESSION_SECRET=change-this-to-a-random-secret-in-production
TENANCY_ENABLED=true
CONTROL_DB_NAME=
CONTROL_DB_USER=
CONTROL_DB_PASSWORD=
TENANT_MASTER_KEY_FILE=
LEGACY_BOOTSTRAP_SEED_ENABLED=true
SEED_ADMIN_PASSWORD=admin123
SEED_TEACHER_PASSWORD=guru123
SEED_PLATFORM_OWNER_PASSWORD=platform-owner
ROTATE_DEMO_SEED_PASSWORDS=false
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=5000
POSTGRES_MAX_CONNECTIONS=50
PUBLIC_BASE_URL=https://cbt-imbs.onrender.com
CORS_ORIGINS=https://cbt-imbs.onrender.com
TLS_HOST=localhost
VITE_SHOW_DEMO_ACCOUNTS=false
VITE_API_BASE_URL=
VITE_TENANCY_ENABLED=true
NODE_ENV=production
PORT=10000
COOKIE_SECURE=true
